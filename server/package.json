{
  "name": "print-better-server",
  "private": true,
  "version": "0.1.3",
  "description": "Self-hosted print server on Cloudflare Workers: web app, REST API, MCP server, and the relay for Print Better clients.",
  "keywords": [
    "printing",
    "print-server",
    "cloudflare-workers",
    "durable-objects",
    "ipp",
    "airprint",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "passkeys",
    "self-hosted",
    "react"
  ],
  "homepage": "https://github.com/yannelli/print-better#readme",
  "bugs": {
    "url": "https://github.com/yannelli/print-better/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannelli/print-better.git",
    "directory": "server"
  },
  "license": "MIT",
  "author": {
    "name": "Ryan Yannelli",
    "url": "https://ryanyannelli.com"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "vitest run",
    "preview": "pnpm build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0",
    "yaml": "^2.9.1"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database for accounts, printers, and jobs."
      },
      "FILES": {
        "description": "R2 bucket for print documents and client downloads."
      },
      "SETUP_TOKEN": {
        "description": "One-time code required to create the first account. Generate a long random string."
      },
      "APP_SECRET": {
        "description": "Random 32+ byte secret used to encrypt instance settings such as SSO client secrets."
      },
      "AUTH_PEPPER": {
        "description": "Random secret mixed into password hashes."
      }
    }
  }
}
